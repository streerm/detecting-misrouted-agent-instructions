{
  "mcpServers": {
    "edgartools": {
      "command": "uvx",
      "args": [
        "--from",
        "edgartools[ai]==6.3.0",
        "edgartools-mcp"
      ],
      "env": {
        "EDGAR_IDENTITY": "${EDGAR_IDENTITY}"
      }
    },
    "fred": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "fred-mcp-server@1.2.0",
        "sh",
        "-c",
        "exec node \"$(realpath \"$(command -v fred-mcp-server)\")\""
      ],
      "env": {
        "FRED_API_KEY": "${FRED_API_KEY}"
      }
    },
    "alphavantage": {
      "command": "uvx",
      "args": [
        "--from",
        "marketdata-mcp-server==0.3.1",
        "--with",
        "mcp<2",
        "marketdata-mcp",
        "${ALPHAVANTAGE_API_KEY}"
      ],
      "env": {
        "ALPHAVANTAGE_API_KEY": "${ALPHAVANTAGE_API_KEY}"
      }
    },
    "finnhub": {
      "command": "uvx",
      "args": [
        "mcp-finnhub==1.1.1"
      ],
      "env": {
        "FINNHUB_API_KEY": "${FINNHUB_API_KEY}",
        "FINNHUB_STORAGE_DIR": "${HOME}/.cache/mcp-finnhub"
      }
    },
    "catalogue": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=1.28,<2",
        "--with",
        "pyyaml",
        "python",
        "mcp_servers/catalogue.py"
      ]
    },
    "dbnomics": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=1.28,<2",
        "--with",
        "pyyaml",
        "python",
        "mcp_servers/dbnomics.py"
      ]
    },
    "arxiv": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=1.28,<2",
        "--with",
        "pyyaml",
        "python",
        "mcp_servers/arxiv.py"
      ]
    },
    "sanctions": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=1.28,<2",
        "--with",
        "pyyaml",
        "python",
        "mcp_servers/sanctions.py"
      ]
    },
    "companies_house": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=1.28,<2",
        "--with",
        "pyyaml",
        "python",
        "mcp_servers/companies_house.py"
      ],
      "env": {
        "COMPANIES_HOUSE_API_KEY": "${COMPANIES_HOUSE_API_KEY}"
      }
    },
    "backtest": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=1.28,<2",
        "--with",
        "pyyaml",
        "python",
        "mcp_servers/backtest.py"
      ]
    },
    "news": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=1.28,<2",
        "--with",
        "pyyaml",
        "python",
        "mcp_servers/news.py"
      ],
      "env": {
        "FINNHUB_API_KEY": "${FINNHUB_API_KEY}",
        "ALPHAVANTAGE_API_KEY": "${ALPHAVANTAGE_API_KEY}"
      }
    }
  }
}
