# =====================================================================================
#  detecting-misrouted-agent-instructions: environment variables
#  Copy to .env (git-ignored) and fill in only what you use. Blank = not configured.
#  Never commit .env. Never paste keys into a chat. .mcp.json refers to these as ${VAR}.
# =====================================================================================

# ---- LLM providers -----------------------------------------------------------------
ANTHROPIC_API_KEY=            # Claude                      console.anthropic.com
OPENAI_API_KEY=               # OpenAI                      platform.openai.com
GOOGLE_API_KEY=               # Gemini                      aistudio.google.com
MISTRAL_API_KEY=              # Mistral                     console.mistral.ai
DEEPSEEK_API_KEY=             # DeepSeek                    platform.deepseek.com
OPENROUTER_API_KEY=           # many models via one key     openrouter.ai
TOGETHER_API_KEY=             # hosted Llama / Qwen         api.together.xyz
GROQ_API_KEY=                 # fast hosted Llama / Qwen    console.groq.com
FIREWORKS_API_KEY=            # hosted open models          fireworks.ai
HF_TOKEN=                     # Hugging Face: gated weights (Llama) + inference
# Local / self-hosted (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1

# ---- the sponsor (tokens / GPU offered by mentors; fill in when provided) ------------
GR_API_KEY=
GR_API_BASE_URL=

# ---- Data sources (MCP servers in .mcp.json) ---------------------------------------
EDGAR_IDENTITY=               # SEC requires "Full Name email@domain" (no key)
FRED_API_KEY=                 # fred.stlouisfed.org/docs/api/api_key.html
ALPHAVANTAGE_API_KEY=         # alphavantage.co/support/#api-key
COMPANIES_HOUSE_API_KEY=      # developer.company-information.service.gov.uk
TAVILY_API_KEY=               # web search tool for agents (optional)

# ---- Tracing / evaluation ----------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=detecting-misrouted-agent-instructions
